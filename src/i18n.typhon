package function string detectLanguage(string localeName) {
    string lower = localeName.lower().replace("-", "_")
    if (lower.startswith("nl")) {
        return "nl"
    }
    if (lower.startswith("dutch")) {
        return "nl"
    }
    if (lower.startswith("nederlands")) {
        return "nl"
    }
    if (lower.find("_nl") >= 0) {
        return "nl"
    }
    if (lower.find("nl_") >= 0) {
        return "nl"
    }
    return "en"
}

package function setLanguage(string lang) {
    if (lang == "nl") {
        state["lang"] = "nl"
    } else {
        state["lang"] = "en"
    }
}

package function string currentLanguage() {
    return state["lang"]
}

package function string t(string key) {
    dict<string, string> catalog = EN
    if (state["lang"] == "nl") {
        catalog = NL
    }
    var hit = catalog.get(key, key)
    return str(hit)
}
