package function string detectLanguage(string localeName) {
    string lower = localeName.lower()
    if (lower.startswith("nl")) {
        return "nl"
    }
    return "en"
}

package function setLanguage(string lang) {
    if (lang == "nl") {
        state["lang"] = "nl"
    } else {
        state["lang"] = "en"
    }
}

package function string currentLanguage() {
    return state["lang"]
}

package function string t(string key) {
    dict<string, string> catalog = EN
    if (state["lang"] == "nl") {
        catalog = NL
    }
    var hit = catalog.get(key, key)
    return str(hit)
}
