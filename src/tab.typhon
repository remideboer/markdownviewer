# One open document: web view + markdown + QWebChannel bridge.

from paths import assetRoot
from document import MarkdownDocument
from bridge import EditorBridge
from i18n import t, currentLanguage
from pathlib import Path
from PyQt6.QtCore import QUrl, Qt, QEvent
from PyQt6.QtWidgets import QWidget, QVBoxLayout
from PyQt6.QtWebEngineWidgets import QWebEngineView
from PyQt6.QtWebChannel import QWebChannel
from PyQt6.QtWebEngineCore import QWebEngineSettings
import json

package class EditorView inherits QWebEngineView {
    public constructor() {
    }

    public contextMenuEvent(object event) {
        this.customContextMenuRequested.emit(event.pos())
    }

    public bool event(object ev) {
        int kind = ev.type()
        if (kind == QEvent.Type.ShortcutOverride || kind == QEvent.Type.KeyPress) {
            int key = ev.key()
            if (key == Qt.Key.Key_Tab || key == Qt.Key.Key_Backtab) {
                if (kind == QEvent.Type.ShortcutOverride) {
                    ev.accept()
                    return true
                }
                string shift = "false"
                if (key == Qt.Key.Key_Backtab) {
                    shift = "true"
                }
                if (key == Qt.Key.Key_Tab) {
                    int mods = ev.modifiers()
                    if (mods & Qt.KeyboardModifier.ShiftModifier) {
                        shift = "true"
                    }
                }
                this.page().runJavaScript("if (window.handleEditorTab) { window.handleEditorTab(" + shift + "); }")
                return true
            }
        }
        return QWebEngineView.event(this, ev)
    }
}

package class EditorTab inherits QWidget {
    public MarkdownDocument doc
    public EditorBridge editorBridge
    public EditorView view
    public QWebChannel channel
    public bool editorReady

    public constructor() {
        this.doc = MarkdownDocument()
        this.editorReady = false
        this.editorBridge = EditorBridge()
        this.editorBridge.doc = this.doc
        this.editorBridge.pendingHref = ""
        this.view = EditorView()
        this.channel = QWebChannel()
        this.channel.registerObject("bridge", this.editorBridge)
        this.view.page().setWebChannel(this.channel)
        this.view.settings().setAttribute(
            QWebEngineSettings.WebAttribute.LocalContentCanAccessFileUrls,
            true
        )
        this.view.settings().setAttribute(
            QWebEngineSettings.WebAttribute.WebGLEnabled,
            false
        )
        this.view.settings().setAttribute(
            QWebEngineSettings.WebAttribute.Accelerated2dCanvasEnabled,
            false
        )
        this.view.settings().setAttribute(
            QWebEngineSettings.WebAttribute.ScrollAnimatorEnabled,
            false
        )
        this.view.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        this.view.loadFinished.connect(this.onEditorLoaded)
        QVBoxLayout layout = QVBoxLayout(this)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(this.view)
        Path webDir = assetRoot().joinpath("web")
        Path htmlFile = webDir.joinpath("editor.html")
        this.view.load(QUrl.fromLocalFile(str(htmlFile.resolve())))
    }

    public onEditorLoaded(bool loaded) {
        if (!loaded) {
            return
        }
        this.editorReady = true
        this.pushUiStrings()
        this.pushMarkdown()
    }

    public pushUiStrings() {
        if (!this.editorReady) {
            return
        }
        string js = "window.setUiStrings(" + json.dumps(t("editor_placeholder")) + ", " + json.dumps(currentLanguage()) + ")"
        this.view.page().runJavaScript(js)
    }

    public pushMarkdown() {
        if (!this.editorReady) {
            return
        }
        string payload = json.dumps(this.doc.getContent())
        string base = ""
        nullable<string> filePath = this.doc.getFilePath()
        if (filePath != null) {
            base = Path(filePath).parent.resolve().as_uri()
            if (!base.endswith("/")) {
                base = base + "/"
            }
        }
        this.view.page().runJavaScript("window.setMarkdown(" + payload + ", " + json.dumps(base) + ")")
    }

    public runCommand(string name, string arg, string arg2) {
        if (!this.editorReady) {
            return
        }
        string js = "window.execEditorCommand(" + json.dumps(name) + ", " + json.dumps(arg) + ", " + json.dumps(arg2) + ")"
        this.view.page().runJavaScript(js)
    }

    public onUndo() {
        this.runCommand("undo", "", "")
    }

    public onRedo() {
        this.runCommand("redo", "", "")
    }

    public onCut() {
        this.runCommand("cut", "", "")
    }

    public onCopy() {
        this.runCommand("copy", "", "")
    }

    public onPaste() {
        this.runCommand("paste", "", "")
    }

    public onSelectAll() {
        this.runCommand("selectAll", "", "")
    }

    public string tabLabel() {
        string name = this.doc.displayName()
        if (this.doc.isDirty()) {
            return "*" + name
        }
        return name
    }
}
