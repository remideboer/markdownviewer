# Main window: tabbed WYSIWYG editors, menu, toolbar.

from paths import assetRoot
from tab import EditorTab
from links import classifyHref, resolveMarkdownLink
from pathlib import Path
from PyQt6.QtWidgets import QMainWindow, QToolBar, QFileDialog, QMessageBox, QInputDialog, QTabWidget
from PyQt6.QtGui import QAction, QDesktopServices
from PyQt6.QtCore import QUrl, QTimer

string MD_FILTER = "Markdown (*.md *.markdown);;Alle bestanden (*.*)"

package class MarkdownViewer inherits QMainWindow {
    private QTabWidget tabs
    private list<EditorTab> pages
    private QTimer titleTimer

    public constructor() {
        this.pages = []
        this.setWindowTitle("MarkdownViewer")
        this.resize(960, 720)
        this.buildMenus()
        this.buildToolbar()
        this.tabs = QTabWidget()
        this.tabs.setTabsClosable(true)
        this.tabs.tabCloseRequested.connect(this.onTabClose)
        this.tabs.currentChanged.connect(this.refreshTitle)
        this.setCentralWidget(this.tabs)
        this.addEditorTab()
        this.titleTimer = QTimer(this)
        this.titleTimer.timeout.connect(this.onTick)
        this.titleTimer.start(300)
        this.refreshTitle()
    }

    public EditorTab currentTab() {
        int index = this.tabs.currentIndex()
        if (index < 0) {
            return this.pages[0]
        }
        return this.pages[index]
    }

    public EditorTab addEditorTab() {
        EditorTab tab = EditorTab()
        this.pages.append(tab)
        this.tabs.addTab(tab, tab.tabLabel())
        this.tabs.setCurrentWidget(tab)
        return tab
    }

    public int indexOfPath(string path) {
        string key = str(Path(path).resolve())
        int i = 0
        loop (i < len(this.pages)) {
            nullable<string> p = this.pages[i].doc.getFilePath()
            if (p != null) {
                if (str(Path(p).resolve()) == key) {
                    return i
                }
            }
            i++
        }
        return -1
    }

    public onTick() {
        this.refreshTabLabels()
        this.refreshTitle()
        EditorTab tab = this.currentTab()
        string href = tab.editorBridge.pendingHref
        if (href != "") {
            tab.editorBridge.pendingHref = ""
            this.openFollowedLink(href)
        }
    }

    public refreshTabLabels() {
        int i = 0
        loop (i < len(this.pages)) {
            this.tabs.setTabText(i, this.pages[i].tabLabel())
            i++
        }
    }

    public refreshTitle() {
        if (len(this.pages) == 0) {
            this.setWindowTitle("MarkdownViewer")
            return
        }
        string name = this.currentTab().tabLabel()
        this.setWindowTitle(name + " — MarkdownViewer")
    }

    public closeEvent(object event) {
        int i = 0
        loop (i < len(this.pages)) {
            if (!this.confirmDiscardTab(this.pages[i])) {
                event.ignore()
                return
            }
            i++
        }
        event.accept()
    }

    public bool confirmDiscardTab(EditorTab tab) {
        if (!tab.doc.isDirty()) {
            return true
        }
        this.tabs.setCurrentWidget(tab)
        int answer = QMessageBox.question(
            this,
            "Niet-opgeslagen wijzigingen",
            "Er zijn niet-opgeslagen wijzigingen in " + tab.doc.displayName() + ". Toch doorgaan?"
        )
        return answer == QMessageBox.StandardButton.Yes
    }

    public onTabClose(int index) {
        if (index < 0) {
            return
        }
        if (index >= len(this.pages)) {
            return
        }
        EditorTab tab = this.pages[index]
        if (len(this.pages) <= 1) {
            if (!this.confirmDiscardTab(tab)) {
                return
            }
            tab.doc.clear()
            tab.pushMarkdown()
            this.refreshTabLabels()
            this.refreshTitle()
            return
        }
        if (!this.confirmDiscardTab(tab)) {
            return
        }
        this.pages.pop(index)
        this.tabs.removeTab(index)
        this.refreshTitle()
    }

    public onNew() {
        this.addEditorTab()
        this.refreshTitle()
    }

    public onOpen() {
        EditorTab tab = this.currentTab()
        if (!this.confirmDiscardTab(tab)) {
            return
        }
        string startDir = this.startDir()
        var picked = QFileDialog.getOpenFileName(this, "Openen", startDir, MD_FILTER)
        string path = str(picked[0])
        if (path == "") {
            return
        }
        if (!tab.doc.loadFrom(path)) {
            QMessageBox.warning(this, "Openen", "Kon het bestand niet lezen.")
            return
        }
        tab.pushMarkdown()
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public onSave() {
        EditorTab tab = this.currentTab()
        if (tab.doc.getFilePath() == null) {
            this.onSaveAs()
            return
        }
        if (!tab.doc.save()) {
            QMessageBox.warning(this, "Opslaan", "Kon het bestand niet schrijven.")
            return
        }
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public onSaveAs() {
        EditorTab tab = this.currentTab()
        string startDir = this.startDir()
        var picked = QFileDialog.getSaveFileName(this, "Opslaan als", startDir, MD_FILTER)
        string path = str(picked[0])
        if (path == "") {
            return
        }
        if (!tab.doc.saveTo(path)) {
            QMessageBox.warning(this, "Opslaan", "Kon het bestand niet schrijven.")
            return
        }
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public string startDir() {
        nullable<string> current = this.currentTab().doc.getFilePath()
        if (current == null) {
            Path samples = assetRoot().joinpath("samples")
            if (samples.is_dir()) {
                return str(samples)
            }
            return ""
        }
        return str(Path(current).parent)
    }

    public openFollowedLink(string href) {
        string kind = classifyHref(href)
        if (kind == "external") {
            QDesktopServices.openUrl(QUrl(href))
            return
        }
        if (kind == "hash") {
            return
        }
        string base = ""
        nullable<string> current = this.currentTab().doc.getFilePath()
        if (current != null) {
            base = current
        }
        string resolved = resolveMarkdownLink(base, href)
        if (resolved == "") {
            QMessageBox.warning(this, "Link", "Kan deze link niet als markdown-bestand openen.")
            return
        }
        int existing = this.indexOfPath(resolved)
        if (existing >= 0) {
            this.tabs.setCurrentIndex(existing)
            this.refreshTitle()
            return
        }
        EditorTab tab = this.addEditorTab()
        if (!tab.doc.loadFrom(resolved)) {
            QMessageBox.warning(this, "Link", "Kon het bestand niet lezen.")
            int added = this.tabs.currentIndex()
            this.pages.pop(added)
            this.tabs.removeTab(added)
            return
        }
        tab.pushMarkdown()
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public onBold() {
        this.currentTab().runCommand("bold", "")
    }

    public onH1() {
        this.currentTab().runCommand("heading", "h1")
    }

    public onH2() {
        this.currentTab().runCommand("heading", "h2")
    }

    public onH3() {
        this.currentTab().runCommand("heading", "h3")
    }

    public onLink() {
        var picked = QInputDialog.getText(this, "Link invoegen", "URL:")
        if (!picked[1]) {
            return
        }
        string url = str(picked[0])
        if (url == "") {
            return
        }
        this.currentTab().runCommand("createLink", url)
    }

    public onBulletList() {
        this.currentTab().runCommand("insertUnorderedList", "")
    }

    public onNumberList() {
        this.currentTab().runCommand("insertOrderedList", "")
    }

    public onHr() {
        this.currentTab().runCommand("insertHorizontalRule", "")
    }

    public onTaskList() {
        this.currentTab().runCommand("insertTaskList", "")
    }

    public buildMenus() {
        var fileMenu = this.menuBar().addMenu("&Bestand")
        QAction newAct = QAction("&Nieuw", this)
        newAct.setShortcut("Ctrl+N")
        newAct.triggered.connect(this.onNew)
        fileMenu.addAction(newAct)
        QAction openAct = QAction("&Openen…", this)
        openAct.setShortcut("Ctrl+O")
        openAct.triggered.connect(this.onOpen)
        fileMenu.addAction(openAct)
        QAction saveAct = QAction("&Opslaan", this)
        saveAct.setShortcut("Ctrl+S")
        saveAct.triggered.connect(this.onSave)
        fileMenu.addAction(saveAct)
        QAction saveAsAct = QAction("Opslaan &als…", this)
        saveAsAct.setShortcut("Ctrl+Shift+S")
        saveAsAct.triggered.connect(this.onSaveAs)
        fileMenu.addAction(saveAsAct)
        fileMenu.addSeparator()
        QAction exitAct = QAction("A&fsluiten", this)
        exitAct.triggered.connect(this.close)
        fileMenu.addAction(exitAct)
    }

    public buildToolbar() {
        QToolBar bar = QToolBar("Opmaak")
        bar.setMovable(false)
        this.addToolBar(bar)
        QAction boldAct = QAction("Vet", this)
        boldAct.setShortcut("Ctrl+B")
        boldAct.setToolTip("Vet (Ctrl+B)")
        boldAct.triggered.connect(this.onBold)
        bar.addAction(boldAct)
        QAction h1Act = QAction("H1", this)
        h1Act.setToolTip("Kop 1")
        h1Act.triggered.connect(this.onH1)
        bar.addAction(h1Act)
        QAction h2Act = QAction("H2", this)
        h2Act.setToolTip("Kop 2")
        h2Act.triggered.connect(this.onH2)
        bar.addAction(h2Act)
        QAction h3Act = QAction("H3", this)
        h3Act.setToolTip("Kop 3")
        h3Act.triggered.connect(this.onH3)
        bar.addAction(h3Act)
        QAction linkAct = QAction("Link", this)
        linkAct.setShortcut("Ctrl+K")
        linkAct.setToolTip("Link invoegen (Ctrl+K)")
        linkAct.triggered.connect(this.onLink)
        bar.addAction(linkAct)
        QAction ulAct = QAction("Lijst", this)
        ulAct.setToolTip("Opsomming")
        ulAct.triggered.connect(this.onBulletList)
        bar.addAction(ulAct)
        QAction olAct = QAction("Genummerd", this)
        olAct.setToolTip("Genummerde lijst")
        olAct.triggered.connect(this.onNumberList)
        bar.addAction(olAct)
        QAction hrAct = QAction("Streep", this)
        hrAct.setToolTip("Horizontale lijn")
        hrAct.triggered.connect(this.onHr)
        bar.addAction(hrAct)
        QAction taskAct = QAction("Taken", this)
        taskAct.setToolTip("Takenlijst")
        taskAct.triggered.connect(this.onTaskList)
        bar.addAction(taskAct)
    }
}
