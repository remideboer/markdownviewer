# Main window: menu, toolbar, QWebEngineView host for the WYSIWYG editor.

from paths import assetRoot
import json
from pathlib import Path
import QApplication, QMainWindow, QToolBar, QFileDialog, QMessageBox, QInputDialog from PyQt6.QtWidgets
import QAction from PyQt6.QtGui
from PyQt6.QtCore import QUrl, QTimer
import QWebEngineView from PyQt6.QtWebEngineWidgets
import QWebChannel from PyQt6.QtWebChannel
import QWebEngineSettings from PyQt6.QtWebEngineCore
from document import MarkdownDocument
from bridge import EditorBridge

string MD_FILTER = "Markdown (*.md *.markdown);;Alle bestanden (*.*)"

package class MarkdownViewer inherits QMainWindow {
    private MarkdownDocument doc
    private EditorBridge editorBridge
    private QWebEngineView view
    private QWebChannel channel
    private QTimer titleTimer
    private bool editorReady

    public constructor() {
        this.doc = MarkdownDocument()
        this.editorReady = false
        this.editorBridge = EditorBridge()
        this.editorBridge.doc = this.doc
        this.setWindowTitle("MarkdownViewer")
        this.resize(960, 720)
        this.buildMenus()
        this.buildToolbar()
        this.view = QWebEngineView()
        this.setCentralWidget(this.view)
        this.channel = QWebChannel()
        this.channel.registerObject("bridge", this.editorBridge)
        this.view.page().setWebChannel(this.channel)
        this.view.settings().setAttribute(
            QWebEngineSettings.WebAttribute.LocalContentCanAccessFileUrls,
            true
        )
        this.view.loadFinished.connect(this.onEditorLoaded)
        Path webDir = assetRoot().joinpath("web")
        Path htmlFile = webDir.joinpath("editor.html")
        this.view.load(QUrl.fromLocalFile(str(htmlFile.resolve())))
        this.titleTimer = QTimer(this)
        this.titleTimer.timeout.connect(this.refreshTitle)
        this.titleTimer.start(300)
        this.refreshTitle()
    }

    public refreshTitle() {
        string name = this.doc.displayName()
        if (this.doc.isDirty()) {
            name = "*" + name
        }
        this.setWindowTitle(name + " — MarkdownViewer")
    }

    public onEditorLoaded(bool loaded) {
        if (!loaded) {
            QMessageBox.warning(
                this,
                "Editor",
                "De editorpagina kon niet worden geladen. Ontbreekt web/editor.html?"
            )
            return
        }
        this.editorReady = true
        this.pushMarkdown()
    }

    public pushMarkdown() {
        if (!this.editorReady) {
            return
        }
        string payload = json.dumps(this.doc.getContent())
        this.view.page().runJavaScript("window.setMarkdown(" + payload + ")")
    }

    public closeEvent(object event) {
        if (!this.confirmDiscard()) {
            event.ignore()
            return
        }
        event.accept()
    }

    public bool confirmDiscard() {
        if (!this.doc.isDirty()) {
            return true
        }
        int answer = QMessageBox.question(
            this,
            "Niet-opgeslagen wijzigingen",
            "Er zijn niet-opgeslagen wijzigingen. Toch doorgaan?"
        )
        return answer == QMessageBox.StandardButton.Yes
    }

    public onNew() {
        if (!this.confirmDiscard()) {
            return
        }
        this.doc.clear()
        this.pushMarkdown()
        this.refreshTitle()
    }

    public onOpen() {
        if (!this.confirmDiscard()) {
            return
        }
        string startDir = this.startDir()
        var picked = QFileDialog.getOpenFileName(this, "Openen", startDir, MD_FILTER)
        string path = str(picked[0])
        if (path == "") {
            return
        }
        if (!this.doc.loadFrom(path)) {
            QMessageBox.warning(this, "Openen", "Kon het bestand niet lezen.")
            return
        }
        this.pushMarkdown()
        this.refreshTitle()
    }

    public onSave() {
        if (this.doc.getFilePath() == null) {
            this.onSaveAs()
            return
        }
        if (!this.doc.save()) {
            QMessageBox.warning(this, "Opslaan", "Kon het bestand niet schrijven.")
            return
        }
        this.refreshTitle()
    }

    public onSaveAs() {
        string startDir = this.startDir()
        var picked = QFileDialog.getSaveFileName(this, "Opslaan als", startDir, MD_FILTER)
        string path = str(picked[0])
        if (path == "") {
            return
        }
        if (!this.doc.saveTo(path)) {
            QMessageBox.warning(this, "Opslaan", "Kon het bestand niet schrijven.")
            return
        }
        this.refreshTitle()
    }

    public string startDir() {
        nullable<string> current = this.doc.getFilePath()
        if (current == null) {
            Path samples = assetRoot() / "samples"
            if (samples.is_dir()) {
                return str(samples)
            }
            return ""
        }
        return str(Path(current).parent)
    }

    public onBold() {
        this.runCommand("bold", "")
    }

    public onH1() {
        this.runCommand("heading", "h1")
    }

    public onH2() {
        this.runCommand("heading", "h2")
    }

    public onH3() {
        this.runCommand("heading", "h3")
    }

    public onLink() {
        var picked = QInputDialog.getText(this, "Link invoegen", "URL:")
        if (!picked[1]) {
            return
        }
        string url = str(picked[0])
        if (url == "") {
            return
        }
        this.runCommand("createLink", url)
    }

    public onBulletList() {
        this.runCommand("insertUnorderedList", "")
    }

    public onNumberList() {
        this.runCommand("insertOrderedList", "")
    }

    public runCommand(string name, string arg) {
        if (!this.editorReady) {
            return
        }
        string js = "window.execEditorCommand(" + json.dumps(name) + ", " + json.dumps(arg) + ")"
        this.view.page().runJavaScript(js)
    }

    public buildMenus() {
        var fileMenu = this.menuBar().addMenu("&Bestand")
        QAction newAct = QAction("&Nieuw", this)
        newAct.setShortcut("Ctrl+N")
        newAct.triggered.connect(this.onNew)
        fileMenu.addAction(newAct)
        QAction openAct = QAction("&Openen…", this)
        openAct.setShortcut("Ctrl+O")
        openAct.triggered.connect(this.onOpen)
        fileMenu.addAction(openAct)
        QAction saveAct = QAction("&Opslaan", this)
        saveAct.setShortcut("Ctrl+S")
        saveAct.triggered.connect(this.onSave)
        fileMenu.addAction(saveAct)
        QAction saveAsAct = QAction("Opslaan &als…", this)
        saveAsAct.setShortcut("Ctrl+Shift+S")
        saveAsAct.triggered.connect(this.onSaveAs)
        fileMenu.addAction(saveAsAct)
        fileMenu.addSeparator()
        QAction exitAct = QAction("A&fsluiten", this)
        exitAct.triggered.connect(this.close)
        fileMenu.addAction(exitAct)
    }

    public buildToolbar() {
        QToolBar bar = QToolBar("Opmaak")
        bar.setMovable(false)
        this.addToolBar(bar)
        QAction boldAct = QAction("Vet", this)
        boldAct.setShortcut("Ctrl+B")
        boldAct.setToolTip("Vet (Ctrl+B)")
        boldAct.triggered.connect(this.onBold)
        bar.addAction(boldAct)
        QAction h1Act = QAction("H1", this)
        h1Act.setToolTip("Kop 1")
        h1Act.triggered.connect(this.onH1)
        bar.addAction(h1Act)
        QAction h2Act = QAction("H2", this)
        h2Act.setToolTip("Kop 2")
        h2Act.triggered.connect(this.onH2)
        bar.addAction(h2Act)
        QAction h3Act = QAction("H3", this)
        h3Act.setToolTip("Kop 3")
        h3Act.triggered.connect(this.onH3)
        bar.addAction(h3Act)
        QAction linkAct = QAction("Link", this)
        linkAct.setShortcut("Ctrl+K")
        linkAct.setToolTip("Link invoegen (Ctrl+K)")
        linkAct.triggered.connect(this.onLink)
        bar.addAction(linkAct)
        QAction ulAct = QAction("Lijst", this)
        ulAct.setToolTip("Opsomming")
        ulAct.triggered.connect(this.onBulletList)
        bar.addAction(ulAct)
        QAction olAct = QAction("Genummerd", this)
        olAct.setToolTip("Genummerde lijst")
        olAct.triggered.connect(this.onNumberList)
        bar.addAction(olAct)
    }
}
