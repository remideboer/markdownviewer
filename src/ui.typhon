    public onLink() {
        QDialog dlg = QDialog(this)
        dlg.setWindowTitle(t("dialog_insert_link"))
        QLineEdit urlEdit = QLineEdit()
        QLineEdit textEdit = QLineEdit()
        QFormLayout form = QFormLayout()
        form.addRow(t("dialog_url"), urlEdit)
        form.addRow(t("dialog_link_text"), textEdit)
        QDialogButtonBox buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.accepted.connect(dlg.accept)
        buttons.rejected.connect(dlg.reject)
        QVBoxLayout box = QVBoxLayout(dlg)
        box.addLayout(form)
        box.addWidget(buttons)
        if (dlg.exec() != QDialog.DialogCode.Accepted) {
            return
        }
        string url = str(urlEdit.text()).strip()
        if (url == "") {
            return
        }
        string linkText = str(textEdit.text())
        this.currentTab().runCommand("insertLink", url, linkText)
    }

    public onTable() {
        QDialog dlg = QDialog(this)
        dlg.setWindowTitle(t("dialog_insert_table"))
        QSpinBox rowBox = QSpinBox()
        rowBox.setMinimum(2)
        rowBox.setMaximum(50)
        rowBox.setValue(3)
        QSpinBox colBox = QSpinBox()
        colBox.setMinimum(1)
        colBox.setMaximum(20)
        colBox.setValue(3)
        QFormLayout form = QFormLayout()
        form.addRow(t("dialog_table_rows"), rowBox)
        form.addRow(t("dialog_table_cols"), colBox)
        QDialogButtonBox buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.accepted.connect(dlg.accept)
        buttons.rejected.connect(dlg.reject)
        QVBoxLayout box = QVBoxLayout(dlg)
        box.addLayout(form)
        box.addWidget(buttons)
        if (dlg.exec() != QDialog.DialogCode.Accepted) {
            return
        }
        this.currentTab().runCommand("insertTable", str(rowBox.value()), str(colBox.value()))
    }

    public onImageBrowse() {
        var picked = QFileDialog.getOpenFileName(this, t("dialog_open_image"), this.startDir(), this.imageFilter(), "", QFileDialog.Option.DontUseNativeDialog)
        string path = str(picked[0])
        if (path == "") {
            return
        }
        this.imageSrcEdit.setText(path)
    }

    public string imageFilter() {
        return "Images (*.png *.jpg *.jpeg *.gif *.webp *.svg *.bmp);;" + t("all_files")
    }

    public bool isRemoteImage(string source) {
        string lower = source.lower()
        if (lower.startswith("http://")) {
            return true
        }
        if (lower.startswith("https://")) {
            return true
        }
        if (lower.startswith("data:")) {
            return true
        }
        return false
    }

    public string uniqueImageDest(string destDir, string fileName) {
        Path folder = Path(destDir)
        Path dest = folder.joinpath(fileName)
        if (!dest.exists()) {
            return str(dest)
        }
        Path src = Path(fileName)
        string stem = src.stem
        string suffix = src.suffix
        int n = 1
        loop (dest.exists()) {
            dest = folder.joinpath(stem + "-" + str(n) + suffix)
            n++
        }
        return str(dest)
    }

    public string markdownImagePath(string docPath, string imagePath) {
        Path docDir = Path(docPath).parent.resolve()
        Path img = Path(imagePath).resolve()
        if (str(img.drive).lower() != str(docDir.drive).lower()) {
            return img.as_uri()
        }
        return str(os.path.relpath(str(img), str(docDir))).replace("\\", "/")
    }

    public onImage() {
        QDialog dlg = QDialog(this)
        dlg.setWindowTitle(t("dialog_insert_image"))
        this.imageSrcEdit = QLineEdit()
        QPushButton browseBtn = QPushButton(t("dialog_image_browse"))
        browseBtn.clicked.connect(this.onImageBrowse)
        QWidget srcRow = QWidget()
        QHBoxLayout srcLayout = QHBoxLayout(srcRow)
        srcLayout.setContentsMargins(0, 0, 0, 0)
        srcLayout.addWidget(this.imageSrcEdit)
        srcLayout.addWidget(browseBtn)
        QLineEdit altEdit = QLineEdit()
        QCheckBox copyBox = QCheckBox(t("dialog_image_copy"))
        copyBox.setChecked(true)
        QFormLayout form = QFormLayout()
        form.addRow(t("dialog_image_src"), srcRow)
        form.addRow(t("dialog_image_alt"), altEdit)
        form.addRow("", copyBox)
        QDialogButtonBox buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.accepted.connect(dlg.accept)
        buttons.rejected.connect(dlg.reject)
        QVBoxLayout box = QVBoxLayout(dlg)
        box.addLayout(form)
        box.addWidget(buttons)
        if (dlg.exec() != QDialog.DialogCode.Accepted) {
            return
        }
        string source = str(this.imageSrcEdit.text()).strip()
        if (source == "") {
            return
        }
        string altText = str(altEdit.text())
        bool copyBeside = copyBox.isChecked()
        string htmlSrc = source
        string mdSrc = source
        if (!this.isRemoteImage(source)) {
            Path srcPath = Path(source)
            if (!srcPath.is_file()) {
                QMessageBox.warning(this, t("dialog_insert_image"), t("error_image_copy"))
                return
            }
            EditorTab tab = this.currentTab()
            nullable<string> docPath = tab.doc.getFilePath()
            if (copyBeside) {
                if (docPath == null) {
                    QMessageBox.warning(this, t("dialog_insert_image"), t("error_image_unsaved"))
                    return
                }
                Path imgDir = Path(docPath).parent.joinpath("images")
                if (!imgDir.is_dir()) {
                    imgDir.mkdir()
                }
                string dest = this.uniqueImageDest(str(imgDir), srcPath.name)
                shutil.copy2(str(srcPath.resolve()), dest)
                mdSrc = "images/" + Path(dest).name
                htmlSrc = Path(dest).resolve().as_uri()
            } else {
                htmlSrc = srcPath.resolve().as_uri()
                if (docPath == null) {
                    mdSrc = htmlSrc
                } else {
                    mdSrc = this.markdownImagePath(docPath, str(srcPath.resolve()))
                }
            }
        }
        dict<string, string> payload = {
            "html": htmlSrc,
            "md": mdSrc,
            "alt": altText
        }
        this.currentTab().runCommand("insertImage", json.dumps(payload), "")
    }

    public onExportPdf() {
        EditorTab tab = this.currentTab()
        string start = this.startDir()
        var picked = QFileDialog.getSaveFileName(this, t("dialog_export_pdf"), start, "PDF (*.pdf)", "", QFileDialog.Option.DontUseNativeDialog)
        string path = str(picked[0])
        if (path == "") {
            return
        }
        this.pendingPdf = path
        tab.view.page().runJavaScript("window.prepareExportPdf()", this.onPdfPrepared)
    }

    public onPdfPrepared(object _result) {
        string path = this.pendingPdf
        if (path == "") {
            return
        }
        QPageLayout layout = QPageLayout(
            QPageSize(QPageSize.PageSizeId.A4),
            QPageLayout.Orientation.Portrait,
            QMarginsF(12.0, 12.0, 12.0, 12.0),
            QPageLayout.Unit.Millimeter
        )
        this.currentTab().view.page().printToPdf(path, layout)
    }

    public onPdfFinished(string path, bool success) {
        int i = 0
        loop (i < len(this.pages)) {
            this.pages[i].view.page().runJavaScript("window.resetPrintLayout && window.resetPrintLayout()")
            i++
        }
        this.pendingPdf = ""
        if (!success) {
            QMessageBox.warning(this, t("dialog_export_pdf"), t("error_pdf"))
        }
    }

    public onBulletList() {
        this.currentTab().runCommand("insertUnorderedList", "", "")
    }

