# Main window: tabbed WYSIWYG editors, menu, toolbar.

from paths import assetRoot
from tab import EditorTab
from links import classifyHref, resolveMarkdownLink
from i18n import t
from icons import toolbarIcon
from pathlib import Path
from PyQt6.QtWidgets import QMainWindow, QToolBar, QFileDialog, QMessageBox, QTabWidget, QDialog, QFormLayout, QLineEdit, QDialogButtonBox, QVBoxLayout, QInputDialog, QComboBox, QMenu, QHBoxLayout, QPushButton, QCheckBox, QSpinBox, QWidget
from PyQt6.QtGui import QAction, QDesktopServices, QPageLayout, QPageSize
from PyQt6.QtCore import QUrl, QTimer, QMarginsF, Qt
import json
import os
import shutil

package class MarkdownViewer inherits QMainWindow {
    private QTabWidget tabs
    private list<EditorTab> pages
    private QTimer titleTimer
    private string pendingPdf
    private QLineEdit imageSrcEdit

    public constructor() {
        this.pages = []
        this.pendingPdf = ""
        this.imageSrcEdit = QLineEdit()
        this.setWindowTitle("MarkdownViewer")
        this.resize(960, 720)
        this.buildMenus()
        this.buildToolbar()
        this.tabs = QTabWidget()
        this.tabs.setTabsClosable(true)
        this.tabs.tabCloseRequested.connect(this.onTabClose)
        this.tabs.currentChanged.connect(this.refreshTitle)
        this.setCentralWidget(this.tabs)
        this.addEditorTab()
        this.titleTimer = QTimer(this)
        this.titleTimer.timeout.connect(this.onTick)
        this.titleTimer.start(300)
        this.refreshTitle()
    }

    public EditorTab currentTab() {
        int index = this.tabs.currentIndex()
        if (index < 0) {
            return this.pages[0]
        }
        return this.pages[index]
    }

    public EditorTab addEditorTab() {
        EditorTab tab = EditorTab()
        tab.view.customContextMenuRequested.connect(this.onEditorContextMenu)
        tab.view.page().pdfPrintingFinished.connect(this.onPdfFinished)
        this.pages.append(tab)
        this.tabs.addTab(tab, tab.tabLabel())
        this.tabs.setCurrentWidget(tab)
        return tab
    }

    public int indexOfPath(string path) {
        string key = str(Path(path).resolve())
        int i = 0
        loop (i < len(this.pages)) {
            nullable<string> p = this.pages[i].doc.getFilePath()
            if (p != null) {
                if (str(Path(p).resolve()) == key) {
                    return i
                }
            }
            i++
        }
        return -1
    }

    public onTick() {
        this.refreshTabLabels()
        this.refreshTitle()
        EditorTab tab = this.currentTab()
        string href = tab.editorBridge.pendingHref
        if (href != "") {
            tab.editorBridge.pendingHref = ""
            this.openFollowedLink(href)
        }
    }

    public refreshTabLabels() {
        int i = 0
        loop (i < len(this.pages)) {
            string label = this.pages[i].tabLabel()
            if (str(this.tabs.tabText(i)) != label) {
                this.tabs.setTabText(i, label)
            }
            i++
        }
    }

    public refreshTitle() {
        if (len(this.pages) == 0) {
            if (this.windowTitle() != "MarkdownViewer") {
                this.setWindowTitle("MarkdownViewer")
            }
            return
        }
        string name = this.currentTab().tabLabel()
        string nextTitle = name + " — MarkdownViewer"
        if (str(this.windowTitle()) != nextTitle) {
            this.setWindowTitle(nextTitle)
        }
    }

    public closeEvent(object event) {
        int i = 0
        loop (i < len(this.pages)) {
            if (!this.confirmDiscardTab(this.pages[i])) {
                event.ignore()
                return
            }
            i++
        }
        event.accept()
    }

    public bool confirmDiscardTab(EditorTab tab) {
        if (!tab.doc.isDirty()) {
            return true
        }
        this.tabs.setCurrentWidget(tab)
        int answer = QMessageBox.question(
            this,
            t("unsaved_title"),
            t("unsaved_body").replace("__NAME__", tab.doc.displayName())
        )
        return answer == QMessageBox.StandardButton.Yes
    }

    public onTabClose(int index) {
        if (index < 0) {
            return
        }
        if (index >= len(this.pages)) {
            return
        }
        EditorTab tab = this.pages[index]
        if (len(this.pages) <= 1) {
            if (!this.confirmDiscardTab(tab)) {
                return
            }
            tab.doc.clear()
            tab.pushMarkdown()
            this.refreshTabLabels()
            this.refreshTitle()
            return
        }
        if (!this.confirmDiscardTab(tab)) {
            return
        }
        this.pages.pop(index)
        this.tabs.removeTab(index)
        this.refreshTitle()
    }

    public onNew() {
        this.addEditorTab()
        this.refreshTitle()
    }

    public onOpen() {
        EditorTab tab = this.currentTab()
        if (!this.confirmDiscardTab(tab)) {
            return
        }
        string startDir = this.startDir()
        var picked = QFileDialog.getOpenFileName(this, t("dialog_open"), startDir, this.mdFilter(), "", QFileDialog.Option.DontUseNativeDialog)
        string path = str(picked[0])
        if (path == "") {
            return
        }
        if (!tab.doc.loadFrom(path)) {
            QMessageBox.warning(this, t("dialog_open"), t("error_read"))
            return
        }
        tab.pushMarkdown()
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public onSave() {
        EditorTab tab = this.currentTab()
        if (tab.doc.getFilePath() == null) {
            this.onSaveAs()
            return
        }
        if (!tab.doc.save()) {
            QMessageBox.warning(this, t("dialog_save"), t("error_write"))
            return
        }
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public onSaveAs() {
        EditorTab tab = this.currentTab()
        string startDir = this.startDir()
        var picked = QFileDialog.getSaveFileName(this, t("dialog_save_as"), startDir, this.mdFilter(), "", QFileDialog.Option.DontUseNativeDialog)
        string path = str(picked[0])
        if (path == "") {
            return
        }
        if (!tab.doc.saveTo(path)) {
            QMessageBox.warning(this, t("dialog_save"), t("error_write"))
            return
        }
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public string startDir() {
        nullable<string> current = this.currentTab().doc.getFilePath()
        if (current == null) {
            Path samples = assetRoot().joinpath("samples")
            if (samples.is_dir()) {
                return str(samples)
            }
            return ""
        }
        return str(Path(current).parent)
    }

    public openFollowedLink(string href) {
        string kind = classifyHref(href)
        if (kind == "external") {
            QDesktopServices.openUrl(QUrl(href))
            return
        }
        if (kind == "hash") {
            return
        }
        string base = ""
        nullable<string> current = this.currentTab().doc.getFilePath()
        if (current != null) {
            base = current
        }
        string resolved = resolveMarkdownLink(base, href)
        if (resolved == "") {
            QMessageBox.warning(this, t("dialog_link"), t("error_link"))
            return
        }
        int existing = this.indexOfPath(resolved)
        if (existing >= 0) {
            this.tabs.setCurrentIndex(existing)
            this.refreshTitle()
            return
        }
        EditorTab tab = this.addEditorTab()
        if (!tab.doc.loadFrom(resolved)) {
            QMessageBox.warning(this, t("dialog_link"), t("error_read"))
            int added = this.tabs.currentIndex()
            this.pages.pop(added)
            this.tabs.removeTab(added)
            return
        }
        tab.pushMarkdown()
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public string mdFilter() {
        return "Markdown (*.md *.markdown);;" + t("all_files")
    }

    public onEditorContextMenu(object pos) {
        EditorTab tab = this.currentTab()
        QMenu menu = QMenu(this)
        QAction undoAct = menu.addAction(t("undo"))
        undoAct.triggered.connect(tab.onUndo)
        QAction redoAct = menu.addAction(t("redo"))
        redoAct.triggered.connect(tab.onRedo)
        menu.addSeparator()
        QAction cutAct = menu.addAction(t("cut"))
        cutAct.triggered.connect(tab.onCut)
        QAction copyAct = menu.addAction(t("copy"))
        copyAct.triggered.connect(tab.onCopy)
        QAction pasteAct = menu.addAction(t("paste"))
        pasteAct.triggered.connect(tab.onPaste)
        QAction selectAct = menu.addAction(t("select_all"))
        selectAct.triggered.connect(tab.onSelectAll)
        menu.addSeparator()
        QAction boldAct = menu.addAction(t("bold"))
        boldAct.triggered.connect(this.onBold)
        QAction h1Act = menu.addAction(t("h1"))
        h1Act.triggered.connect(this.onH1)
        QAction h2Act = menu.addAction(t("h2"))
        h2Act.triggered.connect(this.onH2)
        QAction h3Act = menu.addAction(t("h3"))
        h3Act.triggered.connect(this.onH3)
        QAction h4Act = menu.addAction(t("h4"))
        h4Act.triggered.connect(this.onH4)
        QAction h5Act = menu.addAction(t("h5"))
        h5Act.triggered.connect(this.onH5)
        QAction h6Act = menu.addAction(t("h6"))
        h6Act.triggered.connect(this.onH6)
        QAction textAct = menu.addAction(t("text"))
        textAct.triggered.connect(this.onParagraph)
        QAction italicAct = menu.addAction(t("italic"))
        italicAct.triggered.connect(this.onItalic)
        QAction strikeAct = menu.addAction(t("strike"))
        strikeAct.triggered.connect(this.onStrike)
        QAction quoteAct = menu.addAction(t("quote"))
        quoteAct.triggered.connect(this.onQuote)
        QAction linkAct = menu.addAction(t("link"))
        linkAct.triggered.connect(this.onLink)
        QAction imageAct = menu.addAction(t("image"))
        imageAct.triggered.connect(this.onImage)
        QAction ulAct = menu.addAction(t("list"))
        ulAct.triggered.connect(this.onBulletList)
        QAction olAct = menu.addAction(t("numbered"))
        olAct.triggered.connect(this.onNumberList)
        QAction tableAct = menu.addAction(t("table"))
        tableAct.triggered.connect(this.onTable)
        QAction deflistAct = menu.addAction(t("deflist"))
        deflistAct.triggered.connect(this.onDefList)
        QAction hrAct = menu.addAction(t("rule"))
        hrAct.triggered.connect(this.onHr)
        QAction taskAct = menu.addAction(t("tasks"))
        taskAct.triggered.connect(this.onTaskList)
        QAction codeAct = menu.addAction(t("code"))
        codeAct.triggered.connect(this.onCodeFence)
        QAction mermaidAct = menu.addAction(t("mermaid"))
        mermaidAct.triggered.connect(this.onMermaid)
        menu.exec(tab.view.mapToGlobal(pos))
    }

    public onBold() {
        this.currentTab().runCommand("bold", "", "")
    }

    public onH1() {
        this.currentTab().runCommand("heading", "h1", "")
    }

    public onH2() {
        this.currentTab().runCommand("heading", "h2", "")
    }

    public onH3() {
        this.currentTab().runCommand("heading", "h3", "")
    }

    public onH4() {
        this.currentTab().runCommand("heading", "h4", "")
    }

    public onH5() {
        this.currentTab().runCommand("heading", "h5", "")
    }

    public onH6() {
        this.currentTab().runCommand("heading", "h6", "")
    }

    public onItalic() {
        this.currentTab().runCommand("italic", "", "")
    }

    public onStrike() {
        this.currentTab().runCommand("strike", "", "")
    }

    public onQuote() {
        this.currentTab().runCommand("blockquote", "", "")
    }

    public onDefList() {
        this.currentTab().runCommand("insertDefList", "", "")
