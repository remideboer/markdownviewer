    public onCodeFence() {
        var picked = QInputDialog.getText(this, t("dialog_insert_code"), t("dialog_code_lang"))
        if (!picked[1]) {
            return
        }
        string lang = str(picked[0]).strip()
        this.currentTab().runCommand("insertCodeFence", lang, "")
    }

    public string mermaidKindId(int idx) {
        return switch (idx) {
            case 1 => "sequence"
            case 2 => "class"
            case 3 => "state"
            case 4 => "er"
            case 5 => "c4context"
            case 6 => "c4container"
            case 7 => "c4component"
            case 8 => "c4dynamic"
            case 9 => "pie"
            case 10 => "gantt"
            case 11 => "timeline"
            case 12 => "journey"
            case 13 => "quadrant"
            case 14 => "git"
            case 15 => "mindmap"
            case 16 => "kanban"
            default => "flowchart"
        }
    }

    public onMermaid() {
        QDialog dlg = QDialog(this)
        dlg.setWindowTitle(t("dialog_insert_mermaid"))
        QComboBox kindBox = QComboBox()
        kindBox.addItem(t("mermaid_kind_flowchart"))
        kindBox.addItem(t("mermaid_kind_sequence"))
        kindBox.addItem(t("mermaid_kind_class"))
        kindBox.addItem(t("mermaid_kind_state"))
        kindBox.addItem(t("mermaid_kind_er"))
        kindBox.addItem(t("mermaid_kind_c4context"))
        kindBox.addItem(t("mermaid_kind_c4container"))
        kindBox.addItem(t("mermaid_kind_c4component"))
        kindBox.addItem(t("mermaid_kind_c4dynamic"))
        kindBox.addItem(t("mermaid_kind_pie"))
        kindBox.addItem(t("mermaid_kind_gantt"))
        kindBox.addItem(t("mermaid_kind_timeline"))
        kindBox.addItem(t("mermaid_kind_journey"))
        kindBox.addItem(t("mermaid_kind_quadrant"))
        kindBox.addItem(t("mermaid_kind_git"))
        kindBox.addItem(t("mermaid_kind_mindmap"))
        kindBox.addItem(t("mermaid_kind_kanban"))
        QFormLayout form = QFormLayout()
        form.addRow(t("dialog_mermaid_type"), kindBox)
        QDialogButtonBox buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.accepted.connect(dlg.accept)
        buttons.rejected.connect(dlg.reject)
        QVBoxLayout box = QVBoxLayout(dlg)
        box.addLayout(form)
        box.addWidget(buttons)
        if (dlg.exec() != QDialog.DialogCode.Accepted) {
            return
        }
        string kind = this.mermaidKindId(kindBox.currentIndex())
        this.currentTab().runCommand("insertMermaid", kind, "")
    }

    public buildMenus() {
        var fileMenu = this.menuBar().addMenu(t("menu_file"))
        QAction newAct = QAction(t("action_new"), this)
        newAct.setShortcut("Ctrl+N")
        newAct.triggered.connect(this.onNew)
        fileMenu.addAction(newAct)
        QAction openAct = QAction(t("action_open"), this)
        openAct.setShortcut("Ctrl+O")
        openAct.triggered.connect(this.onOpen)
        fileMenu.addAction(openAct)
        QAction saveAct = QAction(t("action_save"), this)
        saveAct.setShortcut("Ctrl+S")
        saveAct.triggered.connect(this.onSave)
        fileMenu.addAction(saveAct)
        QAction saveAsAct = QAction(t("action_save_as"), this)
        saveAsAct.setShortcut("Ctrl+Shift+S")
        saveAsAct.triggered.connect(this.onSaveAs)
        fileMenu.addAction(saveAsAct)
        fileMenu.addSeparator()
        QAction pdfAct = QAction(t("action_export_pdf"), this)
        pdfAct.triggered.connect(this.onExportPdf)
        fileMenu.addAction(pdfAct)
        fileMenu.addSeparator()
        QAction exitAct = QAction(t("action_exit"), this)
        exitAct.triggered.connect(this.close)
        fileMenu.addAction(exitAct)
    }

    public QAction makeTool(string iconId, string nameKey, string tipKey) {
        QAction act = QAction(t(nameKey), this)
        act.setIcon(toolbarIcon(iconId))
        act.setToolTip(t(tipKey))
        return act
    }

    public buildToolbar() {
        QToolBar bar = QToolBar(t("toolbar_format"))
        bar.setMovable(false)
        bar.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonIconOnly)
        this.addToolBar(bar)
        QAction boldAct = this.makeTool("bold", "bold", "bold_tip")
        boldAct.setShortcut("Ctrl+B")
        boldAct.triggered.connect(this.onBold)
        bar.addAction(boldAct)
        QAction italicAct = this.makeTool("italic", "italic", "italic_tip")
        italicAct.setShortcut("Ctrl+I")
        italicAct.triggered.connect(this.onItalic)
