# Main window: tabbed WYSIWYG editors, menu, toolbar.

from paths import assetRoot
from tab import EditorTab
from links import classifyHref, resolveMarkdownLink
from i18n import t
from pathlib import Path
from PyQt6.QtWidgets import QMainWindow, QToolBar, QFileDialog, QMessageBox, QTabWidget, QDialog, QFormLayout, QLineEdit, QDialogButtonBox, QVBoxLayout, QInputDialog, QComboBox, QMenu
from PyQt6.QtGui import QAction, QDesktopServices
from PyQt6.QtCore import QUrl, QTimer

package class MarkdownViewer inherits QMainWindow {
    private QTabWidget tabs
    private list<EditorTab> pages
    private QTimer titleTimer

    public constructor() {
        this.pages = []
        this.setWindowTitle("MarkdownViewer")
        this.resize(960, 720)
        this.buildMenus()
        this.buildToolbar()
        this.tabs = QTabWidget()
        this.tabs.setTabsClosable(true)
        this.tabs.tabCloseRequested.connect(this.onTabClose)
        this.tabs.currentChanged.connect(this.refreshTitle)
        this.setCentralWidget(this.tabs)
        this.addEditorTab()
        this.titleTimer = QTimer(this)
        this.titleTimer.timeout.connect(this.onTick)
        this.titleTimer.start(300)
        this.refreshTitle()
    }

    public EditorTab currentTab() {
        int index = this.tabs.currentIndex()
        if (index < 0) {
            return this.pages[0]
        }
        return this.pages[index]
    }

    public EditorTab addEditorTab() {
        EditorTab tab = EditorTab()
        tab.view.customContextMenuRequested.connect(this.onEditorContextMenu)
        this.pages.append(tab)
        this.tabs.addTab(tab, tab.tabLabel())
        this.tabs.setCurrentWidget(tab)
        return tab
    }

    public int indexOfPath(string path) {
        string key = str(Path(path).resolve())
        int i = 0
        loop (i < len(this.pages)) {
            nullable<string> p = this.pages[i].doc.getFilePath()
            if (p != null) {
                if (str(Path(p).resolve()) == key) {
                    return i
                }
            }
            i++
        }
        return -1
    }

    public onTick() {
        this.refreshTabLabels()
        this.refreshTitle()
        EditorTab tab = this.currentTab()
        string href = tab.editorBridge.pendingHref
        if (href != "") {
            tab.editorBridge.pendingHref = ""
            this.openFollowedLink(href)
        }
    }

    public refreshTabLabels() {
        int i = 0
        loop (i < len(this.pages)) {
            this.tabs.setTabText(i, this.pages[i].tabLabel())
            i++
        }
    }

    public refreshTitle() {
        if (len(this.pages) == 0) {
            this.setWindowTitle("MarkdownViewer")
            return
        }
        string name = this.currentTab().tabLabel()
        this.setWindowTitle(name + " — MarkdownViewer")
    }

    public closeEvent(object event) {
        int i = 0
        loop (i < len(this.pages)) {
            if (!this.confirmDiscardTab(this.pages[i])) {
                event.ignore()
                return
            }
            i++
        }
        event.accept()
    }

    public bool confirmDiscardTab(EditorTab tab) {
        if (!tab.doc.isDirty()) {
            return true
        }
        this.tabs.setCurrentWidget(tab)
        int answer = QMessageBox.question(
            this,
            t("unsaved_title"),
            t("unsaved_body").replace("__NAME__", tab.doc.displayName())
        )
        return answer == QMessageBox.StandardButton.Yes
    }

    public onTabClose(int index) {
        if (index < 0) {
            return
        }
        if (index >= len(this.pages)) {
            return
        }
        EditorTab tab = this.pages[index]
        if (len(this.pages) <= 1) {
            if (!this.confirmDiscardTab(tab)) {
                return
            }
            tab.doc.clear()
            tab.pushMarkdown()
            this.refreshTabLabels()
            this.refreshTitle()
            return
        }
        if (!this.confirmDiscardTab(tab)) {
            return
        }
        this.pages.pop(index)
        this.tabs.removeTab(index)
        this.refreshTitle()
    }

    public onNew() {
        this.addEditorTab()
        this.refreshTitle()
    }

    public onOpen() {
        EditorTab tab = this.currentTab()
        if (!this.confirmDiscardTab(tab)) {
            return
        }
        string startDir = this.startDir()
        var picked = QFileDialog.getOpenFileName(this, t("dialog_open"), startDir, this.mdFilter())
        string path = str(picked[0])
        if (path == "") {
            return
        }
        if (!tab.doc.loadFrom(path)) {
            QMessageBox.warning(this, t("dialog_open"), t("error_read"))
            return
        }
        tab.pushMarkdown()
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public onSave() {
        EditorTab tab = this.currentTab()
        if (tab.doc.getFilePath() == null) {
            this.onSaveAs()
            return
        }
        if (!tab.doc.save()) {
            QMessageBox.warning(this, t("dialog_save"), t("error_write"))
            return
        }
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public onSaveAs() {
        EditorTab tab = this.currentTab()
        string startDir = this.startDir()
        var picked = QFileDialog.getSaveFileName(this, t("dialog_save_as"), startDir, this.mdFilter())
        string path = str(picked[0])
        if (path == "") {
            return
        }
        if (!tab.doc.saveTo(path)) {
            QMessageBox.warning(this, t("dialog_save"), t("error_write"))
            return
        }
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public string startDir() {
        nullable<string> current = this.currentTab().doc.getFilePath()
        if (current == null) {
            Path samples = assetRoot().joinpath("samples")
            if (samples.is_dir()) {
                return str(samples)
            }
            return ""
        }
        return str(Path(current).parent)
    }

    public openFollowedLink(string href) {
        string kind = classifyHref(href)
        if (kind == "external") {
            QDesktopServices.openUrl(QUrl(href))
            return
        }
        if (kind == "hash") {
            return
        }
        string base = ""
        nullable<string> current = this.currentTab().doc.getFilePath()
        if (current != null) {
            base = current
        }
        string resolved = resolveMarkdownLink(base, href)
        if (resolved == "") {
            QMessageBox.warning(this, t("dialog_link"), t("error_link"))
            return
        }
        int existing = this.indexOfPath(resolved)
        if (existing >= 0) {
            this.tabs.setCurrentIndex(existing)
            this.refreshTitle()
            return
        }
        EditorTab tab = this.addEditorTab()
        if (!tab.doc.loadFrom(resolved)) {
            QMessageBox.warning(this, t("dialog_link"), t("error_read"))
            int added = this.tabs.currentIndex()
            this.pages.pop(added)
            this.tabs.removeTab(added)
            return
        }
        tab.pushMarkdown()
        this.refreshTabLabels()
        this.refreshTitle()
    }

    public string mdFilter() {
        return "Markdown (*.md *.markdown);;" + t("all_files")
    }

    public onEditorContextMenu(object pos) {
        EditorTab tab = this.currentTab()
        QMenu menu = QMenu(this)
        QAction undoAct = menu.addAction(t("undo"))
        undoAct.triggered.connect(tab.onUndo)
        QAction redoAct = menu.addAction(t("redo"))
        redoAct.triggered.connect(tab.onRedo)
        menu.addSeparator()
        QAction cutAct = menu.addAction(t("cut"))
        cutAct.triggered.connect(tab.onCut)
        QAction copyAct = menu.addAction(t("copy"))
        copyAct.triggered.connect(tab.onCopy)
        QAction pasteAct = menu.addAction(t("paste"))
        pasteAct.triggered.connect(tab.onPaste)
        QAction selectAct = menu.addAction(t("select_all"))
        selectAct.triggered.connect(tab.onSelectAll)
        menu.addSeparator()
        QAction boldAct = menu.addAction(t("bold"))
        boldAct.triggered.connect(this.onBold)
        QAction h1Act = menu.addAction(t("h1"))
        h1Act.triggered.connect(this.onH1)
        QAction h2Act = menu.addAction(t("h2"))
        h2Act.triggered.connect(this.onH2)
        QAction h3Act = menu.addAction(t("h3"))
        h3Act.triggered.connect(this.onH3)
        QAction linkAct = menu.addAction(t("link"))
        linkAct.triggered.connect(this.onLink)
        QAction ulAct = menu.addAction(t("list"))
        ulAct.triggered.connect(this.onBulletList)
        QAction olAct = menu.addAction(t("numbered"))
        olAct.triggered.connect(this.onNumberList)
        QAction hrAct = menu.addAction(t("rule"))
        hrAct.triggered.connect(this.onHr)
        QAction taskAct = menu.addAction(t("tasks"))
        taskAct.triggered.connect(this.onTaskList)
        QAction codeAct = menu.addAction(t("code"))
        codeAct.triggered.connect(this.onCodeFence)
        QAction mermaidAct = menu.addAction(t("mermaid"))
        mermaidAct.triggered.connect(this.onMermaid)
        menu.exec(tab.view.mapToGlobal(pos))
    }

    public onBold() {
        this.currentTab().runCommand("bold", "", "")
    }

    public onH1() {
        this.currentTab().runCommand("heading", "h1", "")
    }

    public onH2() {
        this.currentTab().runCommand("heading", "h2", "")
    }

    public onH3() {
        this.currentTab().runCommand("heading", "h3", "")
    }

    public onLink() {
        QDialog dlg = QDialog(this)
        dlg.setWindowTitle(t("dialog_insert_link"))
        QLineEdit urlEdit = QLineEdit()
        QLineEdit textEdit = QLineEdit()
        QFormLayout form = QFormLayout()
        form.addRow(t("dialog_url"), urlEdit)
        form.addRow(t("dialog_link_text"), textEdit)
        QDialogButtonBox buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.accepted.connect(dlg.accept)
        buttons.rejected.connect(dlg.reject)
        QVBoxLayout box = QVBoxLayout(dlg)
        box.addLayout(form)
        box.addWidget(buttons)
        if (dlg.exec() != QDialog.DialogCode.Accepted) {
            return
        }
        string url = str(urlEdit.text()).strip()
        if (url == "") {
            return
        }
        string linkText = str(textEdit.text())
        this.currentTab().runCommand("insertLink", url, linkText)
    }

    public onBulletList() {
        this.currentTab().runCommand("insertUnorderedList", "", "")
    }

    public onNumberList() {
        this.currentTab().runCommand("insertOrderedList", "", "")
    }

    public onHr() {
        this.currentTab().runCommand("insertHorizontalRule", "", "")
    }

    public onTaskList() {
        this.currentTab().runCommand("insertTaskList", "", "")
    }

    public onCodeFence() {
        var picked = QInputDialog.getText(this, t("dialog_insert_code"), t("dialog_code_lang"))
        if (!picked[1]) {
            return
        }
        string lang = str(picked[0]).strip()
        this.currentTab().runCommand("insertCodeFence", lang, "")
    }

    public string mermaidKindId(int idx) {
        if (idx == 1) {
            return "sequence"
        }
        if (idx == 2) {
            return "class"
        }
        if (idx == 3) {
            return "state"
        }
        if (idx == 4) {
            return "er"
        }
        if (idx == 5) {
            return "c4context"
        }
        if (idx == 6) {
            return "c4container"
        }
        if (idx == 7) {
            return "c4component"
        }
        if (idx == 8) {
            return "c4dynamic"
        }
        if (idx == 9) {
            return "pie"
        }
        if (idx == 10) {
            return "gantt"
        }
        if (idx == 11) {
            return "timeline"
        }
        if (idx == 12) {
            return "journey"
        }
        if (idx == 13) {
            return "quadrant"
        }
        if (idx == 14) {
            return "git"
        }
        if (idx == 15) {
            return "mindmap"
        }
        if (idx == 16) {
            return "kanban"
        }
        return "flowchart"
    }

    public onMermaid() {
        QDialog dlg = QDialog(this)
        dlg.setWindowTitle(t("dialog_insert_mermaid"))
        QComboBox kindBox = QComboBox()
        kindBox.addItem(t("mermaid_kind_flowchart"))
        kindBox.addItem(t("mermaid_kind_sequence"))
        kindBox.addItem(t("mermaid_kind_class"))
        kindBox.addItem(t("mermaid_kind_state"))
        kindBox.addItem(t("mermaid_kind_er"))
        kindBox.addItem(t("mermaid_kind_c4context"))
        kindBox.addItem(t("mermaid_kind_c4container"))
        kindBox.addItem(t("mermaid_kind_c4component"))
        kindBox.addItem(t("mermaid_kind_c4dynamic"))
        kindBox.addItem(t("mermaid_kind_pie"))
        kindBox.addItem(t("mermaid_kind_gantt"))
        kindBox.addItem(t("mermaid_kind_timeline"))
        kindBox.addItem(t("mermaid_kind_journey"))
        kindBox.addItem(t("mermaid_kind_quadrant"))
        kindBox.addItem(t("mermaid_kind_git"))
        kindBox.addItem(t("mermaid_kind_mindmap"))
        kindBox.addItem(t("mermaid_kind_kanban"))
        QFormLayout form = QFormLayout()
        form.addRow(t("dialog_mermaid_type"), kindBox)
        QDialogButtonBox buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.accepted.connect(dlg.accept)
        buttons.rejected.connect(dlg.reject)
        QVBoxLayout box = QVBoxLayout(dlg)
        box.addLayout(form)
        box.addWidget(buttons)
        if (dlg.exec() != QDialog.DialogCode.Accepted) {
            return
        }
        string kind = this.mermaidKindId(kindBox.currentIndex())
        this.currentTab().runCommand("insertMermaid", kind, "")
    }

    public buildMenus() {
        var fileMenu = this.menuBar().addMenu(t("menu_file"))
        QAction newAct = QAction(t("action_new"), this)
        newAct.setShortcut("Ctrl+N")
        newAct.triggered.connect(this.onNew)
        fileMenu.addAction(newAct)
        QAction openAct = QAction(t("action_open"), this)
        openAct.setShortcut("Ctrl+O")
        openAct.triggered.connect(this.onOpen)
        fileMenu.addAction(openAct)
        QAction saveAct = QAction(t("action_save"), this)
        saveAct.setShortcut("Ctrl+S")
        saveAct.triggered.connect(this.onSave)
        fileMenu.addAction(saveAct)
        QAction saveAsAct = QAction(t("action_save_as"), this)
        saveAsAct.setShortcut("Ctrl+Shift+S")
        saveAsAct.triggered.connect(this.onSaveAs)
        fileMenu.addAction(saveAsAct)
        fileMenu.addSeparator()
        QAction exitAct = QAction(t("action_exit"), this)
        exitAct.triggered.connect(this.close)
        fileMenu.addAction(exitAct)
    }

    public buildToolbar() {
        QToolBar bar = QToolBar(t("toolbar_format"))
        bar.setMovable(false)
        this.addToolBar(bar)
        QAction boldAct = QAction(t("bold"), this)
        boldAct.setShortcut("Ctrl+B")
        boldAct.setToolTip(t("bold_tip"))
        boldAct.triggered.connect(this.onBold)
        bar.addAction(boldAct)
        QAction h1Act = QAction(t("h1"), this)
        h1Act.setToolTip(t("h1_tip"))
        h1Act.triggered.connect(this.onH1)
        bar.addAction(h1Act)
        QAction h2Act = QAction(t("h2"), this)
        h2Act.setToolTip(t("h2_tip"))
        h2Act.triggered.connect(this.onH2)
        bar.addAction(h2Act)
        QAction h3Act = QAction(t("h3"), this)
        h3Act.setToolTip(t("h3_tip"))
        h3Act.triggered.connect(this.onH3)
        bar.addAction(h3Act)
        QAction linkAct = QAction(t("link"), this)
        linkAct.setShortcut("Ctrl+K")
        linkAct.setToolTip(t("link_tip"))
        linkAct.triggered.connect(this.onLink)
        bar.addAction(linkAct)
        QAction ulAct = QAction(t("list"), this)
        ulAct.setToolTip(t("list_tip"))
        ulAct.triggered.connect(this.onBulletList)
        bar.addAction(ulAct)
        QAction olAct = QAction(t("numbered"), this)
        olAct.setToolTip(t("numbered_tip"))
        olAct.triggered.connect(this.onNumberList)
        bar.addAction(olAct)
        QAction hrAct = QAction(t("rule"), this)
        hrAct.setToolTip(t("rule_tip"))
        hrAct.triggered.connect(this.onHr)
        bar.addAction(hrAct)
        QAction taskAct = QAction(t("tasks"), this)
        taskAct.setToolTip(t("tasks_tip"))
        taskAct.triggered.connect(this.onTaskList)
        bar.addAction(taskAct)
        QAction codeAct = QAction(t("code"), this)
        codeAct.setToolTip(t("code_tip"))
        codeAct.triggered.connect(this.onCodeFence)
        bar.addAction(codeAct)
        QAction mermaidAct = QAction(t("mermaid"), this)
        mermaidAct.setToolTip(t("mermaid_tip"))
        mermaidAct.triggered.connect(this.onMermaid)
        bar.addAction(mermaidAct)
    }
}
