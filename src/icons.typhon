# Small toolbar glyphs drawn with QPainter. No image files.

from PyQt6.QtGui import QIcon, QPixmap, QPainter, QColor, QPen, QFont
from PyQt6.QtCore import Qt, QRect

function QColor ink() {
    return QColor(31, 31, 31)
}

function drawLetters(QPainter paint, string text, bool bold, bool italic, int px) {
    QFont font = QFont("Segoe UI", 9)
    font.setPixelSize(px)
    if (bold) {
        font.setWeight(QFont.Weight.Bold)
    }
    if (italic) {
        font.setItalic(true)
    }
    paint.setFont(font)
    paint.setPen(ink())
    paint.drawText(QRect(0, 0, 22, 22), int(Qt.AlignmentFlag.AlignCenter), text)
}

function drawOutline(QPainter paint) {
    paint.setBrush(QColor(0, 0, 0, 0))
    paint.setPen(QPen(ink(), 2))
}

package function QIcon toolbarIcon(string id) {
    QPixmap pix = QPixmap(22, 22)
    pix.fill(QColor(0, 0, 0, 0))
    QPainter paint = QPainter(pix)
    paint.setRenderHint(QPainter.RenderHint.Antialiasing, true)
    paint.setPen(QPen(ink(), 2))
    paint.setBrush(ink())
    if (id == "bold") {
        drawLetters(paint, "B", true, false, 14)
    } else if (id == "italic") {
        drawLetters(paint, "I", false, true, 14)
    } else if (id == "strike") {
        drawLetters(paint, "S", true, false, 13)
        paint.setPen(QPen(ink(), 2))
        paint.drawLine(4, 11, 18, 11)
    } else if (id == "quote") {
        paint.drawLine(7, 6, 7, 13)
        paint.drawLine(7, 6, 10, 6)
        paint.drawLine(14, 6, 14, 13)
        paint.drawLine(14, 6, 17, 6)
    } else if (id == "h1") {
        drawLetters(paint, "H1", true, false, 11)
    } else if (id == "h2") {
        drawLetters(paint, "H2", true, false, 11)
    } else if (id == "h3") {
        drawLetters(paint, "H3", true, false, 11)
    } else if (id == "h4") {
        drawLetters(paint, "H4", true, false, 11)
    } else if (id == "h5") {
        drawLetters(paint, "H5", true, false, 11)
    } else if (id == "h6") {
        drawLetters(paint, "H6", true, false, 11)
    } else if (id == "text") {
        drawLetters(paint, "T", false, false, 13)
    } else if (id == "link") {
        drawOutline(paint)
        paint.drawEllipse(2, 6, 10, 10)
        paint.drawEllipse(10, 6, 10, 10)
    } else if (id == "image") {
        drawOutline(paint)
        paint.drawRect(3, 5, 16, 12)
        paint.setBrush(ink())
        paint.drawEllipse(13, 7, 4, 4)
        paint.drawLine(4, 16, 9, 10)
        paint.drawLine(9, 10, 13, 15)
    } else if (id == "list") {
        paint.drawEllipse(4, 5, 3, 3)
        paint.drawEllipse(4, 10, 3, 3)
        paint.drawEllipse(4, 15, 3, 3)
        paint.drawLine(9, 6, 18, 6)
        paint.drawLine(9, 11, 18, 11)
        paint.drawLine(9, 16, 18, 16)
    } else if (id == "numbered") {
        drawLetters(paint, "1.", true, false, 11)
    } else if (id == "table") {
        drawOutline(paint)
        paint.drawRect(3, 4, 16, 14)
        paint.drawLine(3, 9, 19, 9)
        paint.drawLine(3, 14, 19, 14)
        paint.drawLine(11, 4, 11, 18)
    } else if (id == "deflist") {
        paint.drawLine(4, 6, 18, 6)
        paint.drawLine(8, 11, 18, 11)
        paint.drawLine(8, 16, 18, 16)
    } else if (id == "rule") {
        paint.drawLine(3, 11, 19, 11)
    } else if (id == "tasks") {
        drawOutline(paint)
        paint.drawRect(5, 5, 12, 12)
        paint.drawLine(7, 11, 10, 15)
        paint.drawLine(10, 15, 16, 7)
    } else if (id == "code") {
        drawLetters(paint, "</>", true, false, 9)
    } else if (id == "mermaid") {
        drawOutline(paint)
        paint.drawLine(11, 3, 19, 11)
        paint.drawLine(19, 11, 11, 19)
        paint.drawLine(11, 19, 3, 11)
        paint.drawLine(3, 11, 11, 3)
    } else {
        drawLetters(paint, "?", false, false, 13)
    }
    paint.end()
    return QIcon(pix)
}
