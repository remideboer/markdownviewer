# Language detection and catalog lookup (no Qt).

from i18n import detectLanguage, setLanguage, t, currentLanguage

function void assertTrue(string name, bool cond) {
    if (!cond) {
        print("FAIL " + name)
    } else {
        print("PASS " + name)
    }
}

print("=== i18n ===")

assertTrue("nl-NL", detectLanguage("nl-NL") == "nl")
assertTrue("dutch windows", detectLanguage("Dutch_Netherlands") == "nl")
assertTrue("en_NL region", detectLanguage("en_NL") == "nl")
assertTrue("nl", detectLanguage("nl") == "nl")
assertTrue("NL_BE", detectLanguage("NL_BE") == "nl")
assertTrue("en_US", detectLanguage("en_US") == "en")
assertTrue("de_DE", detectLanguage("de_DE") == "en")
assertTrue("empty", detectLanguage("") == "en")

setLanguage("en")
assertTrue("lang en", currentLanguage() == "en")
assertTrue("untitled en", t("untitled") == "Untitled")
assertTrue("missing key", t("no_such_key") == "no_such_key")

setLanguage("nl")
assertTrue("lang nl", currentLanguage() == "nl")
assertTrue("untitled nl", t("untitled") == "Naamloos")
assertTrue("menu nl", t("menu_file") == "&Bestand")
assertTrue("link text nl", t("dialog_link_text") == "Linktekst:")
assertTrue("open tab nl", t("action_open_tab") == "Openen in nieuw &tabblad…")
assertTrue("cut nl", t("cut") == "Knippen")
assertTrue("text nl", t("text") == "Tekst")
assertTrue("text tip nl", t("text_tip") == "Normale tekst")
assertTrue("h1 tip nl", t("h1_tip") == "Kop 1 (nogmaals voor normale tekst)")
assertTrue("h4 nl", t("h4") == "H4")
assertTrue("italic nl", t("italic") == "Cursief")
assertTrue("table nl", t("table") == "Tabel")
assertTrue("image nl", t("image") == "Afbeelding")
assertTrue("quote nl", t("quote") == "Citaat")
assertTrue("deflist nl", t("deflist") == "Begrippen")
assertTrue("strike nl", t("strike") == "Doorhalen")
assertTrue("pdf nl", t("action_export_pdf") == "Exporteren als &PDF…")
assertTrue("code nl", t("code") == "Code")
assertTrue("mermaid nl", t("mermaid") == "Diagram")
assertTrue("mermaid tip nl", t("mermaid_tip") == "Diagram invoegen")
assertTrue("sequence nl", t("mermaid_kind_sequence") == "Sequencediagram")

setLanguage("en")
assertTrue("link text en", t("dialog_link_text") == "Link text:")
assertTrue("open tab en", t("action_open_tab") == "Open in new &tab…")
assertTrue("cut en", t("cut") == "Cut")
assertTrue("text en", t("text") == "Text")
assertTrue("text tip en", t("text_tip") == "Normal text")
assertTrue("h4 en", t("h4") == "H4")
assertTrue("italic en", t("italic") == "Italic")
assertTrue("table en", t("table") == "Table")
assertTrue("image en", t("image") == "Image")
assertTrue("quote en", t("quote") == "Quote")
assertTrue("deflist en", t("deflist") == "Terms")
assertTrue("strike en", t("strike") == "Strike")
assertTrue("pdf en", t("action_export_pdf") == "Export as &PDF…")
assertTrue("code lang en", t("dialog_code_lang") == "Language (optional):")
assertTrue("mermaid tip en", t("mermaid_tip") == "Insert diagram")
assertTrue("c4 en", t("mermaid_kind_c4context") == "C4 Context")

setLanguage("fr")
assertTrue("unknown falls to en", currentLanguage() == "en")
assertTrue("untitled after fallback", t("untitled") == "Untitled")

print("=== i18n done ===")
